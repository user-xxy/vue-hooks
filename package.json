{
  "name": "@user-xxy/vue-hooks",
  "version": "0.1.0",
  "description": "Composition-API hooks for Vue 3 — built from real-world admin, H5, and mini-program projects.",
  "author": "yangyanghongchao <yangyanghongchao@gmail.com>",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/user-xxy/vue-hooks.git"
  },
  "bugs": {
    "url": "https://github.com/user-xxy/vue-hooks/issues"
  },
  "homepage": "https://github.com/user-xxy/vue-hooks#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm typecheck"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "dependencies": {
    "@user-xxy/utils": "^0.1.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vue": "^3.4.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "composables",
    "hooks"
  ],
  "engines": {
    "node": ">=18"
  }
}
